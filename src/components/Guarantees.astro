---
import { site } from '../data/site';
import Icon from './Icon.astro';

const items = site.guarantees;
---

<section id="garansi" class="scroll-mt-20 border-t border-base-300 py-12 md:py-16">
  <div class="mx-auto w-full max-w-5xl px-4">
    <h2 class="text-2xl font-bold sm:text-3xl">SOP rapi &amp; pekerjaan bergaransi</h2>
    <p class="mt-2 max-w-[60ch] text-base-content/70">
      Cara kami bekerja di rumah atau kantor Anda.
    </p>

    <div class="mt-8 grid gap-4 md:grid-cols-3">
      {
        items.map((item) => (
          <div class="rounded-xl border border-base-300 bg-base-100 p-5">
            <span class="grid size-10 place-items-center rounded-lg bg-[var(--primary-soft)] text-[var(--primary-soft-content)]">
              <Icon name={item.icon} class="size-5" />
            </span>
            <h3 class="mt-3 text-base font-semibold">{item.title}</h3>
            <p class="mt-1 text-sm text-base-content/70">{item.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
