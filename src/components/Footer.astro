---
import { site, waLink } from '../data/site';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
---

<footer class="border-t border-base-300 bg-base-100 py-10">
  <div class="mx-auto grid w-full max-w-5xl gap-8 px-4 md:grid-cols-3">
    <div>
      <div class="flex items-center gap-2.5">
        <img
          src="/images/logo-mark.png"
          alt="Logo MB Teknik Selaras"
          width="40"
          height="40"
          class="h-10 w-10 object-contain"
        />
        <span class="font-semibold">MB Teknik Selaras</span>
      </div>
      <p class="mt-3 text-sm text-base-content/70">
        Jasa cuci, servis, dan pasang AC panggilan di Cileungsi, Jonggol, dan
        Narogong. Dikelola oleh {site.owner}.
      </p>
    </div>

    <div>
      <h2 class="text-sm font-semibold">Kontak &amp; jam buka</h2>
      <ul class="mt-3 grid gap-2 text-sm">
        <li>
          <a
            href={waLink('Halo MB Teknik Selaras, saya ingin bertanya soal layanan AC.')}
            class="inline-flex items-center gap-2 hover:text-primary"
            target="_blank"
            rel="noopener"
          >
            <Icon name="brand-whatsapp" class="size-4 text-primary" />
            WhatsApp {site.whatsapp.display}
          </a>
        </li>
        <li class="flex items-start gap-2">
          <Icon name="clock" class="mt-0.5 size-4 shrink-0 text-primary" />
          <span>
            {site.hours.label}
            <span class="block text-base-content/60">{site.hours.note}</span>
          </span>
        </li>
      </ul>
    </div>

    <div>
      <h2 class="text-sm font-semibold">Alamat bengkel</h2>
      <ul class="mt-3 grid gap-3 text-sm">
        {
          site.locations.map((location) => (
            <li class="flex gap-2">
              <Icon name="map-pin" class="mt-0.5 size-4 shrink-0 text-primary" />
              <span>
                <span class="font-medium">{location.branch} - {location.shortName}</span>
                <span class="block text-base-content/60">{location.address}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div
    class="mx-auto mt-8 flex w-full max-w-5xl flex-wrap items-center justify-between gap-2 border-t border-base-300 px-4 pt-4 text-xs text-base-content/60"
  >
    <span>© {year} MB Teknik Selaras.</span>
    <span>Melayani sejak 2019 - Pekerjaan bergaransi.</span>
  </div>
</footer>
