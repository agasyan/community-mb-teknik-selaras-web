---
import sun from '@tabler/icons/outline/sun.svg?raw';
import moon from '@tabler/icons/outline/moon.svg?raw';
import brandWhatsapp from '@tabler/icons/outline/brand-whatsapp.svg?raw';
import phone from '@tabler/icons/outline/phone.svg?raw';
import mapPin from '@tabler/icons/outline/map-pin.svg?raw';
import route from '@tabler/icons/outline/route.svg?raw';
import clock from '@tabler/icons/outline/clock.svg?raw';
import shieldCheck from '@tabler/icons/outline/shield-check.svg?raw';
import spray from '@tabler/icons/outline/spray.svg?raw';
import gauge from '@tabler/icons/outline/gauge.svg?raw';
import wind from '@tabler/icons/outline/wind.svg?raw';
import tool from '@tabler/icons/outline/tool.svg?raw';
import plus from '@tabler/icons/outline/plus.svg?raw';
import arrowsExchange from '@tabler/icons/outline/arrows-exchange.svg?raw';
import circleCheck from '@tabler/icons/outline/circle-check.svg?raw';
import chevronRight from '@tabler/icons/outline/chevron-right.svg?raw';
import snowflake from '@tabler/icons/outline/snowflake.svg?raw';
import droplet from '@tabler/icons/outline/droplet.svg?raw';
import bolt from '@tabler/icons/outline/bolt.svg?raw';
import buildingStore from '@tabler/icons/outline/building-store.svg?raw';
import alertCircle from '@tabler/icons/outline/alert-circle.svg?raw';
import send from '@tabler/icons/outline/send.svg?raw';
import calendar from '@tabler/icons/outline/calendar.svg?raw';
import user from '@tabler/icons/outline/user.svg?raw';

const map: Record<string, string> = {
  sun,
  moon,
  'brand-whatsapp': brandWhatsapp,
  phone,
  'map-pin': mapPin,
  route,
  clock,
  'shield-check': shieldCheck,
  spray,
  gauge,
  wind,
  tool,
  plus,
  exchange: arrowsExchange,
  'circle-check': circleCheck,
  'chevron-right': chevronRight,
  snowflake,
  droplet,
  bolt,
  'building-store': buildingStore,
  'alert-circle': alertCircle,
  send,
  calendar,
  user,
};

interface Props {
  name: keyof typeof map | string;
  class?: string;
  stroke?: number;
}

const { name, class: className = 'size-5', stroke } = Astro.props;

let svg = map[name] ?? '';
svg = svg.replace(/\sclass="[^"]*"/, '');
svg = svg.replace(
  '<svg',
  `<svg class="${className} shrink-0" aria-hidden="true" focusable="false"`,
);
if (stroke) {
  svg = svg.replace('stroke-width="2"', `stroke-width="${stroke}"`);
}
---

<Fragment set:html={svg} />
