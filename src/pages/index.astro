---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import Gallery from '../components/Gallery.astro';
import BookingForm from '../components/BookingForm.astro';
import Locations from '../components/Locations.astro';
import Guarantees from '../components/Guarantees.astro';
import Footer from '../components/Footer.astro';
import MobileStickyBar from '../components/MobileStickyBar.astro';
---

<BaseLayout>
  <Header />
  <main>
    <Hero />
    <Services />
    <Gallery />
    <BookingForm />
    <Locations />
    <Guarantees />
  </main>
  <Footer />
  <MobileStickyBar />
</BaseLayout>
